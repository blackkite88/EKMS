# ─── LLM (Groq) ───
GROQ_API_KEY=your_groq_api_key_here

# ─── Embeddings ───
# Provider: "ollama" (local, per spec) or "jina" (cloud fallback, works through Zscaler)
EMBEDDING_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=all-minilm
JINA_API_KEY=
JINA_EMBED_MODEL=jina-embeddings-v2-base-en

# ─── Reranking (Jina cross-encoder) ───
JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual

# ─── Vector store (ChromaDB) ───
CHROMA_URL=http://localhost:8000

# ─── Graph store (Neo4j) ───
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nexorapass

# ─── Relational backbone (Postgres) ───
POSTGRES_URL=postgres://nexora:nexorapass@localhost:5432/nexora

# ─── Auth ───
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=12h

# ─── MCP Actions (optional — actions fall back to simulation if unset) ───
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=NEX
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=me

# ─── Server ───
PORT=3001
