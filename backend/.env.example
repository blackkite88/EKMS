# ─── LLM (Groq) ───
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Embeddings ───
# Provider: "ollama" (local) or "jina" (cloud, works through Zscaler) — Jina is
# what the demo dataset was built/evaluated against.
EMBEDDING_PROVIDER=jina
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=all-minilm
JINA_API_KEY=your_jina_api_key_here
JINA_EMBED_MODEL=jina-embeddings-v2-base-en

# ─── Reranking (Jina cross-encoder) ───
JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual

# ─── Vector store (ChromaDB) ───
CHROMA_URL=http://localhost:8000

# ─── Graph store (Neo4j) ───
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nexorapass

# ─── Relational backbone (Postgres) ───
# Must match docker-compose.yml's postgres service credentials.
POSTGRES_URL=postgres://nexora:nexorapass@localhost:5432/nexora

# ─── Auth ───
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=12h

# ─── Server ───
PORT=3001
